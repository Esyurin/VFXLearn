      x: 0
      y: -300
      width: 386
      height: 220
    contents: "220\uB3C4 \uC6D0\uD638(ArcRibbon). \uC218\uBA85 0.15\uCD08 \uB3D9\uC548
      -35\uB3C4\uC5D0\uC11C 85\uB3C4\uB85C \uD68C\uC804\uD558\uBA70 \uCF1C\uC84C\uB2E4\uAC00
