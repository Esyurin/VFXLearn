    colorTheme: 1
  - title: "D \uC811\uC120 \uC9C1\uC120"
    position:
      serializedVersion: 2
      x: 1013
      y: -292
      width: 386
      height: 220
    contents: "\uC6D0\uD638\uAC00 \uC18C\uBA78\uD558\uAE30 \uC9C1\uC804(7/60\uCD08)\uC5D0
      \uC6D0\uD638 \uB05D \uC811\uC120(180\uB3C4 \uC9C0\uC810, 270\uB3C4 \uBC29\uD5A5)\uC73C\uB85C
      \uD654\uBA74\uC744 \uAC00\uB85C\uC9C0\uB974\uB294 \uC9C1\uC120. \uC218\uBA85
      0.2\uCD08."
    theme: Classic
    textSize: Small
    colorTheme: 1
  - title: "F \uC810\uC120 \uD30C\uD2F0\uD074"
    position:
      serializedVersion: 2
      x: 3992
      y: -285
      width: 426
      height: 240
    contents: "\uC6D0\uD638 \uC18C\uBA78 \uC9C1\uD6C4(0.15\uCD08) \uAC19\uC740 \uC6D0\uD638(-25~195\uB3C4)
      \uC704\uC5D0 \uC810 120\uAC1C. t\xB7angSpeed \uCEE4\uC2A4\uD140 \uC18D\uC131\uC73C\uB85C
      \uC6D0\uD638\uB97C \uB530\uB77C \uBB34\uC791\uC704 \uC774\uB3D9, \uC218\uBA85
      0.6~0.9\uCD08. \uC810 \uBCF8\uCCB4\uC640 \uB9E5\uB3D9 \uAE00\uB85C\uC6B0 \uB450
      \uCD9C\uB825."
    theme: Classic
    textSize: Small
    colorTheme: 1
  - title: "E \uC9C0\uBA74 \uCDA9\uACA9"
    position:
      serializedVersion: 2
      x: 5435
      y: -277
      width: 566
      height: 220
    contents: "\uCDA9\uB3CC \uC9C0\uC810 (-1, -1.2, 0). \uAD11\uC6D0: 7/60\uCD08,
      0.1\uCD08. \uB9C1: 8/60\uCD08, 0.38\uCD08, XZ \uD3C9\uBA74, 0.08\uCD08\uC5D0
      \uBC18\uACBD 1.15\uAE4C\uC9C0 \uD37C\uC9C4 \uB4A4 0.3\uCD08 \uB178\uC774\uC988
      \uB514\uC878\uBE0C. \uC904\uBB34\uB2AC 320\uAC1C: \uC218\uBA85 0.25~0.41\uCD08(\uB178\uC774\uC988),
